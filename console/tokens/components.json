{
  "$description": "Component layer: what each component paints with, in meaning-layer names. Same in both tones.",
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": "{brand.font.display}"
    },
    "sans": {
      "$value": "{brand.font.sans}"
    }
  },
  "radius": {
    "$type": "dimension",
    "part": {
      "$value": "{brand.radius.part}"
    },
    "panel": {
      "$value": "{brand.radius.panel}"
    },
    "key": {
      "$value": "{brand.radius.key}"
    },
    "pill": {
      "$value": "{brand.radius.pill}"
    }
  },
  "mark": {
    "$type": "gradient",
    "bg": {
      "$value": "{brand.mark}"
    }
  },
  "nav": {
    "$type": "color",
    "bg": {
      "$value": "{color.sunk}"
    },
    "ink": {
      "$value": "{color.muted}"
    },
    "current-bg": {
      "$value": "{color.selected}"
    },
    "current-ink": {
      "$value": "{color.on-selected}"
    }
  },
  "button": {
    "$type": "color",
    "primary-bg": {
      "$value": "{color.selected}"
    },
    "primary-ink": {
      "$value": "{color.on-selected}"
    },
    "quiet-bg": {
      "$value": "{color.sunk}"
    },
    "quiet-ink": {
      "$value": "{color.muted}"
    }
  },
  "avatar": {
    "$type": "color",
    "ink": {
      "$value": "{brand.paper.ink}"
    },
    "blue": {
      "$value": "{brand.pastel.blue}"
    },
    "lavender": {
      "$value": "{brand.pastel.lavender}"
    },
    "rose": {
      "$value": "{brand.pastel.rose}"
    },
    "sun": {
      "$value": "{brand.pastel.sun}"
    },
    "leaf": {
      "$value": "{brand.pastel.leaf}"
    }
  },
  "slip": {
    "$type": "color",
    "bg": {
      "$type": "gradient",
      "$value": "{brand.slip}"
    },
    "orb": {
      "$type": "gradient",
      "$value": "{brand.orb}"
    },
    "ink": {
      "$value": "{brand.paper.ink}"
    },
    "key": {
      "$value": "{brand.pastel.sun}"
    }
  }
}
